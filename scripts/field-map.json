{
  "_comment": "SINGLE SOURCE OF TRUTH for the Umbrava-wire <-> canonical-df field vocabulary. This file is CANONICAL here (the api/* routes require it at runtime); a byte-identical mirror lives at userscripts/scripts/field-map.json (test-time only - the TM producer cannot require a file in the browser). Edit BOTH or they drift (same rule as the caveman skill mirror). Derived 2026-08-13 from the four prior restatements it replaces: Core heatDatasetRows (producer), api/wo-ingest jobFacts allowlist, api/dataset-ingest STR/DATE/NUM_MAP, agent.html WO_ALIASES. Adding a field = edit this file, then the conformance test each side fails until both carry it. INVARIANTS the tests enforce: every fields[].canonical is a WO_ALIASES key in agent.html; every enrichmentOnly column is too; the live route maps are a subset of fields[] with matching canonical; every wire key a producer emits is declared with that producer tagged.",
  "_schemaVersion": 1,
  "fields": [
    { "wire": "target",             "canonical": "Tracking Number",         "gql": "trackingNumber",                      "type": "str",  "scale": "digits-only",           "producers": ["board", "live-jobs"], "note": "join key the upload path lacks" },
    { "wire": "woNumber",           "canonical": "WO #",                     "gql": "formattedJobNumber",                  "type": "str",  "scale": null,                    "producers": ["board", "live-jobs"] },
    { "wire": "sourceJob",          "canonical": "Job ID",                   "gql": "sourceJobNumber",                     "type": "str",  "scale": null,                    "producers": ["board", "live-jobs"] },
    { "wire": "sourcePo",           "canonical": "Source PO #",              "gql": "sourcePurchaseOrderNumber",           "type": "str",  "scale": null,                    "producers": ["board", "live-jobs"] },
    { "wire": "status",             "canonical": "Status",                   "gql": "statusName",                          "type": "str",  "scale": null,                    "producers": ["board", "live-jobs"] },
    { "wire": "statusHrs",          "canonical": "Status Hrs",               "gql": "timeInStatus",                        "type": "num",  "scale": "minutes/60->HOURS",     "producers": ["board", "live-jobs"], "note": "timeInStatus is MINUTES; Core divides by 60 before sending" },
    { "wire": "aged",               "canonical": "Aged",                     "gql": "numberOfDays",                        "type": "num",  "scale": null,                    "producers": ["board", "live-jobs"], "note": "Open phase only; means days-to-complete on closed WOs" },
    { "wire": "amount",             "canonical": "Amount",                   "gql": "doNotExceed",                         "type": "num",  "scale": "minor-units->DOLLARS",  "producers": ["board", "live-jobs"], "note": "bwnMoney: amount / 10^precision" },
    { "wire": "vendorNte",          "canonical": "Total Vendor NTE",         "gql": "totalNTE",                            "type": "num",  "scale": "minor-units->DOLLARS",  "producers": ["board", "live-jobs"], "note": "vendor-cost NTE; a DIFFERENT number from amount (client DNE)" },
    { "wire": "coordinator",        "canonical": "Assigned To",              "gql": "assignedToMemberName",                "type": "str",  "scale": "drop 'Team ...'",       "producers": ["board", "live-jobs"], "note": "the NAME field, never the assignedTo GUID; a 'Team ...' value is a client team, dropped" },
    { "wire": "priority",           "canonical": "Priority",                 "gql": "priority.label",                      "type": "str",  "scale": null,                    "producers": ["board", "live-jobs"] },
    { "wire": "trades",             "canonical": "Trades",                   "gql": "trades[].name",                       "type": "str",  "scale": "array join",            "producers": ["board", "live-jobs"] },
    { "wire": "vendors",            "canonical": "Vendors",                  "gql": "vendorNames[]",                       "type": "str",  "scale": "array of strings",      "producers": ["board", "live-jobs"], "note": "plain strings not objects; empty array (no vendor) differs from absent (not selected)" },
    { "wire": "client",             "canonical": "Client",                   "gql": "clientName",                          "type": "str",  "scale": null,                    "producers": ["board", "live-jobs"] },
    { "wire": "location",           "canonical": "Location",                 "gql": "locationName",                        "type": "str",  "scale": null,                    "producers": ["live-jobs"],          "note": "live-jobs only today; board route accepts it for when the board producer adds it" },
    { "wire": "fm",                 "canonical": "FM",                       "gql": "(derived)",                           "type": "str",  "scale": null,                    "producers": ["live-jobs"],          "note": "live-jobs only today; board route accepts it" },
    { "wire": "city",               "canonical": "City",                     "gql": "address.city",                        "type": "str",  "scale": null,                    "producers": ["live-jobs"],          "note": "live-jobs only today; board route accepts it" },
    { "wire": "state",              "canonical": "State",                    "gql": "address.state",                       "type": "str",  "scale": null,                    "producers": ["live-jobs"],          "note": "live-jobs only today; board route accepts it" },
    { "wire": "daysSinceUpdate",    "canonical": "Days Since Update",        "gql": "(computed)",                          "type": "num",  "scale": null,                    "producers": ["live-jobs"],          "note": "live-jobs only today; board route accepts it" },
    { "wire": "docCount",           "canonical": "Doc Count",                "gql": "jobDocuments count (!isArchived)",    "type": "num",  "scale": "count",                 "producers": ["live-jobs"],          "note": "per-job docs-present count; Core writes bwn:docs:<wo> from readDocs() (confident reads only - unknown stays absent, never 0), pushJobFacts carries it. Track A docs-closure slice." },
    { "wire": "projectType",        "canonical": "Project Type",             "gql": "(derived Service|WiFi|Photometrics)", "type": "str",  "scale": "unknown->Service",      "producers": ["board"] },
    { "wire": "woDate",             "canonical": "WO Date",                  "gql": "workOrderDate",                       "type": "date", "scale": null,                    "producers": ["board", "live-jobs"] },
    { "wire": "nextOnsiteDate",     "canonical": "Next Onsite Date",         "gql": "nextOnsiteDate",                      "type": "date", "scale": null,                    "producers": ["board", "live-jobs"] },
    { "wire": "expectedCompletion", "canonical": "Expected Completion Date", "gql": "priority.expectedCompletionDate",     "type": "date", "scale": null,                    "producers": ["board", "live-jobs"] },
    { "wire": "lastNoteDate",       "canonical": "Last Note Date",           "gql": "lastNoteDate",                        "type": "date", "scale": null,                    "producers": ["board"],              "note": "primary staleness signal" },
    { "wire": "firstTripDate",      "canonical": "First Trip Date",          "gql": "priority.firstTripDate",              "type": "date", "scale": null,                    "producers": ["live-jobs"],          "note": "live-jobs only (pushJobFacts); wo-ingest DATE allowlist accepts it; no board producer emits it yet" },
    { "wire": "lastUpdated",        "canonical": "Last Updated",             "gql": "lastModifiedDate",                    "type": "date", "scale": null,                    "producers": ["live-jobs"],          "note": "live-jobs only (pushJobFacts); wo-ingest DATE allowlist accepts it; the upload path fills 'Latest Update'" }
  ],
  "enrichmentOnly": {
    "_comment": "Canonical df columns that ride the DAILY UPLOAD path only (human/agent-entered or agent-computed). No wire producer; Track A does NOT source these. Listed so a conformance test knows they are intentionally producer-less, not orphans.",
    "columns": ["Notes", "Approved_Flag", "Approved_Amount", "Mgmt Assist Needed", "Mgmt Notes", "Last Reviewed By", "Escalation Priority", "Scope Of Work"]
  }
}
